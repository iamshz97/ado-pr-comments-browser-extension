{
  "manifest_version": 3,
  "name": "Copy Azure DevOps PR Comments for LLM",
  "short_name": "PR Comments",
  "version": "1.0.0",
  "description": "Copy the unresolved review comments from an Azure DevOps pull request as clean, AI-ready Markdown. Runs locally.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Copy Azure DevOps PR Comments for LLM",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open the PR comments popup"
    }
  }
}
