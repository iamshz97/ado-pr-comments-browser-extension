{
  "manifest_version": 3,
  "name": "PR Comments for Azure DevOps",
  "short_name": "PR Comments",
  "version": "0.1.0",
  "description": "Summarize Azure DevOps pull request review comments and copy them, anonymized, straight into an LLM.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "PR Comments",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open PR Comments"
    }
  }
}
